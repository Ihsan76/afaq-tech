for data in THEMES:
    obj, created = Theme.objects.update_or_create(
        name=data["name"],
        defaults=data,
    )
    status = "created" if created else "updated"
    print(f"  {data['icon']} {data['name_ar']} — {status}")

print(f"\nDone: {Theme.objects.count()} themes in database.")
