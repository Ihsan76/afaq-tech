# نسخ إلى ملف .env في جذر المستودع (docker-compose.prod.yml يستخدمه للربط)

# --- Cloudflare Tunnel (مطلوب) ---
# أنشئ tunnel من Cloudflare Zero Trust > Networks > Tunnels > Create
# وانسخ Token. ثم في إعدادات الـ tunnel اضبط ingress على:
#   afaq.app        -> http://frontend:3000
#   api.afaq.app    -> http://backend:8000
CLOUDFLARE_TUNNEL_TOKEN=

# --- فرونت إند ---
NEXT_PUBLIC_API_URL=https://api.afaq.app/api/v1
NEXT_PUBLIC_SITE_URL=https://afaq.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# --- اختياري (تجاوزات) ---
# ALLOWED_HOSTS=afaq.app,www.afaq.app,api.afaq.app
# CORS_ALLOWED_ORIGINS=https://afaq.app,https://www.afaq.app
# CSRF_TRUSTED_ORIGINS=https://afaq.app,https://www.afaq.app
# FRONTEND_URL=https://afaq.app
